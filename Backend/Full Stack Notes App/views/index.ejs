```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notes — Your Personal Space</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-out',
                        'slide-up': 'slideUp 0.5s ease-out'
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' }
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' }
                        }
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body class="bg-[#09090b] text-white font-sans min-h-screen">

    <div class="fixed inset-0 pointer-events-none overflow-hidden">
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 -right-40 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl"></div>
    </div>

    <main class="relative max-w-7xl mx-auto px-5 sm:px-8 py-8">

        <nav class="flex items-center justify-between mb-14">
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-blue-500 to-violet-600 flex items-center justify-center shadow-lg shadow-blue-500/20 group-hover:scale-105 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h6l5 5v11a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="font-bold text-lg tracking-tight">Notes</h1>
                    <p class="text-xs text-zinc-500">Your personal workspace</p>
                </div>
            </a>

            <div class="hidden sm:flex items-center gap-3">
                <div class="px-4 py-2 rounded-full border border-white/10 bg-white/[0.03] text-sm text-zinc-400">
                    <%= files.length %> notes
                </div>
            </div>
        </nav>

        <section class="mb-12 animate-fade-in">
            <div class="max-w-3xl">
                <p class="text-blue-400 text-sm font-semibold uppercase tracking-[0.2em] mb-3">
                    Your thoughts
                </p>
                <h2 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.05]">
                    Capture ideas.
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-violet-400 to-purple-400">
                        Stay organized.
                    </span>
                </h2>
                <p class="text-zinc-500 mt-5 text-base sm:text-lg max-w-xl leading-relaxed">
                    Write down your ideas, tasks and thoughts in one beautiful, distraction-free space.
                </p>
            </div>
        </section>

        <section class="mb-14 animate-slide-up">
            <div class="relative rounded-3xl border border-white/10 bg-white/[0.035] backdrop-blur-xl p-5 sm:p-7 shadow-2xl shadow-black/20">

                <div class="flex items-center gap-3 mb-6">
                    <div class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold">Create a new note</h3>
                        <p class="text-xs text-zinc-500">Put your thoughts somewhere safe.</p>
                    </div>
                </div>

                <form action="/create" method="post" class="space-y-4">

                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-2">
                            TITLE
                        </label>
                        <input
                            class="w-full rounded-2xl border border-white/10 bg-black/20 px-5 py-4 text-white placeholder-zinc-600 outline-none transition focus:border-blue-500/60 focus:ring-4 focus:ring-blue-500/10"
                            type="text"
                            placeholder="Give your note a title..."
                            name="title"
                            required
                        >
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-zinc-400 mb-2">
                            CONTENT
                        </label>
                        <textarea
                            class="w-full min-h-[150px] rounded-2xl border border-white/10 bg-black/20 px-5 py-4 text-white placeholder-zinc-600 outline-none transition focus:border-blue-500/60 focus:ring-4 focus:ring-blue-500/10 resize-none"
                            placeholder="Start writing your thoughts..."
                            name="details"
                            required
                        ></textarea>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
                        <p class="text-xs text-zinc-600">
                            Your note will be saved instantly.
                        </p>

                        <button
                            type="submit"
                            class="group flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-white text-black font-semibold text-sm hover:bg-zinc-200 active:scale-[0.98] transition"
                        >
                            Create Note
                            <svg class="w-4 h-4 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-5-5l5 5-5 5"/>
                            </svg>
                        </button>
                    </div>

                </form>
            </div>
        </section>

        <section>

            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
                <div>
                    <p class="text-xs text-zinc-600 uppercase tracking-widest font-semibold mb-2">
                        Collection
                    </p>
                    <h2 class="text-2xl font-bold tracking-tight">Your Notes</h2>
                </div>

                <% if(files.length > 0){ %>
                    <div class="relative">
                        <input
                            id="search"
                            type="text"
                            placeholder="Search notes..."
                            class="w-full sm:w-64 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-2.5 pl-10 text-sm outline-none placeholder-zinc-600 focus:border-white/20"
                        >
                        <svg class="absolute left-3 top-3 w-4 h-4 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </div>
                <% } %>
            </div>

            <% if(files.length == 0){ %>

                <div class="rounded-3xl border border-dashed border-white/10 bg-white/[0.02] py-20 text-center">
                    <div class="w-16 h-16 mx-auto rounded-2xl bg-white/[0.04] flex items-center justify-center mb-5">
                        <svg class="w-7 h-7 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h6l5 5v11a2 2 0 01-2 2z"/>
                        </svg>
                    </div>

                    <h3 class="text-lg font-semibold text-zinc-300">
                        No notes yet
                    </h3>

                    <p class="text-sm text-zinc-600 mt-2">
                        Create your first note above and start building your collection.
                    </p>
                </div>

            <% } else { %>

                <div id="notesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

                    <% files.forEach(function(val, index){ %>

                        <article
                            class="note-card group relative rounded-3xl border border-white/10 bg-white/[0.035] p-6 hover:bg-white/[0.06] hover:border-white/20 hover:-translate-y-1 transition-all duration-300 overflow-hidden"
                            data-title="<%= val %>"
                        >

                            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-500 via-violet-500 to-purple-500 opacity-0 group-hover:opacity-100 transition"></div>

                            <div class="flex items-start justify-between gap-4 mb-8">
                                <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 3v3m8-3v3M5 9h14M6 5h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2z"/>
                                    </svg>
                                </div>

                                <span class="text-xs text-zinc-700">
                                    #<%= String(index + 1).padStart(2, '0') %>
                                </span>
                            </div>

                            <h3 class="text-xl font-bold tracking-tight text-zinc-100 truncate">
                                <%= val %>
                            </h3>

                            <p class="text-sm text-zinc-600 mt-2">
                                Personal note
                            </p>

                            <div class="mt-7 pt-5 border-t border-white/5">
                                <a
                                    class="inline-flex items-center gap-2 text-sm font-medium text-zinc-400 group-hover:text-white transition"
                                    href="/files/<%= val %>"
                                >
                                    Open note
                                    <svg class="w-4 h-4 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-5-5l5 5-5 5"/>
                                    </svg>
                                </a>
                            </div>

                        </article>

                    <% }) %>

                </div>

                <div id="noResults" class="hidden rounded-3xl border border-dashed border-white/10 py-16 text-center">
                    <p class="text-zinc-500">No notes match your search.</p>
                </div>

            <% } %>

        </section>

        <footer class="py-12 mt-10 text-center">
            <p class="text-xs text-zinc-700">
                Built for your ideas · Keep creating.
            </p>
        </footer>

    </main>

    <script>
        const search = document.getElementById('search');
        const cards = document.querySelectorAll('.note-card');
        const noResults = document.getElementById('noResults');

        if (search) {
            search.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                let visible = 0;

                cards.forEach(card => {
                    const title = card.dataset.title.toLowerCase();
                    const match = title.includes(query);

                    card.classList.toggle('hidden', !match);

                    if (match) visible++;
                });

                if (noResults) {
                    noResults.classList.toggle('hidden', visible !== 0);
                }
            });
        }
    </script>

</body>
</html>
```
